NODE_ENV=development
HOST=0.0.0.0
PORT=3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# Direct Postgres pool: size, wait for a free connection, idle close, query deadline.
PG_POOL_MAX=20
PG_POOL_CONNECTION_TIMEOUT_MS=2000
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=8000
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8000
REDIS_URL=redis://redis:6379/0
PLACE_CACHE_TTL_SECONDS=3600
MAP_TILE_CACHE_TTL_SECONDS=604800
MAP_TILE_VERSION=1
