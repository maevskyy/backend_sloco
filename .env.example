# Image tags rendered by the production deploy workflow.
BACKEND_IMAGE=ghcr.io/maevskyy/backend_sloco:prod-latest
RECOMMENDATION_SERVICE_IMAGE=ghcr.io/maevskyy/recommender_sloco:prod-latest

# Gateway runtime.
NODE_ENV=production
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8000
PLACE_CACHE_TTL_SECONDS=3600
# Direct Postgres pool (SUPABASE_DB_URL): size, wait for a free connection,
# idle close, query deadline. Past a wait/deadline the gateway answers 503.
PG_POOL_MAX=20
PG_POOL_CONNECTION_TIMEOUT_MS=2000
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=8000

# Recommendation service runtime.
RECOMMENDATION_APP_ENV=production
RECOMMENDATION_LOG_LEVEL=info
# uvicorn worker processes = recommendations computed in parallel (~2.6 GB RAM each).
RECOMMENDATION_WORKERS=4

# Walk Planner (compose profile `walk-planner`, not deployed yet — SLO-68).
# Host dir holding bundle directories; WALK_BUNDLE_ID picks the one to serve.
WALK_BUNDLES_HOST_DIR=/opt/sloco-data/walk/bundles
WALK_BUNDLE_ID=bucharest-20261002-d68a311e
# Empty = straight-line legs only (no OSRM / ORS yet).
WALK_ROUTER_URL=
ORS_API_KEY=
PHOTO_BASE_URL=
# uvicorn workers (~1.3 GB RAM each in the worst burst, one core each).
WALK_PLANNER_WORKERS=2

# Cache and self-hosted observability.
REDIS_URL=redis://redis:6379/0
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
GF_SERVER_ROOT_URL=http://localhost:3001
