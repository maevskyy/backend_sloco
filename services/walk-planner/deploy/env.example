# walk-planner environment: template for /opt/sloco-data/walk/walk.env (lives in the data dir, so it survives
# code deploys). Holds a secret (ORS_API_KEY), so:
#   install -m 600 deploy/env.example /opt/sloco-data/walk/walk.env
# Used twice by deploy/docker-compose.yml: as `--env-file` (fills the ${...} in the compose file) and as
# `env_file:` (the container environment). Format: KEY=value, one per line, comments on their own lines,
# single-quote values that contain `$` or `#`. A commented-out key means "use the default shown".
# Never commit a filled-in copy, and never pass secrets on a command line (they show up in `ps`).

# ---------------------------------------------------------------------------------------------------------
# Deployment selection (compose interpolation only; not read by the service itself)
# ---------------------------------------------------------------------------------------------------------
# REQUIRED. Directory name under /opt/sloco-data/walk/bundles/ (= the manifest's bundle_id). The container
# gets WALK_BUNDLE_DIR=/bundles/<WALK_BUNDLE_ID>. Switching or rolling back the data = change it + `up -d`.
WALK_BUNDLE_ID=bucharest-YYYYMMDD-xxxxxxxx
# Image to run. The tag = ALGORITHM_VERSION (+ sha-<git>). `local` = built on this host by `up --build`.
# WALK_PLANNER_IMAGE=sloco-walk-planner
# WALK_PLANNER_TAG=local
# Loopback port on the host (curl / smoke tests). The gateway talks to walk-planner:8000 on the Docker network.
# WALK_PLANNER_HOST_PORT=18600
# Host paths.
# WALK_BUNDLES_HOST_DIR=/opt/sloco-data/walk/bundles
# OSRM_HOST_DIR=/opt/osrm
# Resource limits of the walk-planner container. Memory, measured 2026-10-03 (this image on Docker / arm64, the
# Bucharest bundle, 2 workers, bursts of 30 concurrent large plans: golden S08 24 h, S16 all slots, S22 50 km, S07):
#   idle: ~0.5 GB RSS per worker + ~0.13 GB uvicorn supervisor (container ~0.9 GB);
#   WALK_MAX_CONCURRENT_PLANS=2 (default): per-worker peak 0.60-0.64 GB, container peak 1.1 GB, all 30 served
#     in ~71 s by clients retrying on 503 (p50 34 s), search p50 75 ms meanwhile;
#   WALK_MAX_CONCURRENT_PLANS=4: per-worker peak 0.68-0.73 GB, container peak 1.3 GB, 64 s, search p50 129 ms;
#   no limit (64): per-worker peak 1.06-1.12 GB, container peak 2.1 GB, 68 s but p50 56 s, search up to 1.9 s.
# 3g = 2 workers x ~1.3 GB worst case + supervisor + headroom. Raise it with WEB_CONCURRENCY (~1.3 GB each).
# WALK_PLANNER_CPUS=2
# WALK_PLANNER_MEM_LIMIT=3g
# OSRM_CPUS=1
# OSRM_MEM_LIMIT=2g
# Recorded in the image (label + WALK_GIT_SHA) when building with compose.
# GIT_SHA=unknown

# ---------------------------------------------------------------------------------------------------------
# Service (walk_planner.service)
# ---------------------------------------------------------------------------------------------------------
# WALK_BUNDLE_DIR is set by compose from WALK_BUNDLE_ID (do not set it here). Outside compose: path of one
# bundle directory (manifest.json inside), or of a directory of bundles (one per city). The service refuses
# to start (and the image's entrypoint exits 78) without a valid bundle.
# Public base URL of the photo files: card photo url = PHOTO_BASE_URL + "/" + key, where key is
# "photos_cid/<cid>/<NN>_<label>.jpg" (see deploy/photos.nginx.conf.example). Empty = photos carry keys
# only (url null).
PHOTO_BASE_URL=
# Default language of message texts (ru | en); requests may ask for the other one.
WALK_DEFAULT_LANG=ru
# Default segment geometry when a request does not choose: geojson (LineString coordinates) | polyline6.
# WALK_GEOMETRY_DEFAULT=geojson
# DEBUG | INFO | WARNING | ERROR (JSON log lines on stdout).
LOG_LEVEL=INFO
# Echoed in GET /v1/meta (production | staging | development).
ENVIRONMENT=production
# uvicorn worker processes (CPU-bound work: one core each). Also divide the ORS limits below by it, and raise
# WALK_PLANNER_MEM_LIMIT with it (~1.3 GB per worker, see above).
WEB_CONCURRENCY=2
# Load guard, PER WORKER: plan / schedule / insert requests one worker runs at once. One more is answered at
# once with 503 {"error": {"code": "busy"}} + Retry-After: 2 (the gateway retries or tells the user); search,
# place, config, meta and health are never limited. The service therefore runs at most
# WEB_CONCURRENCY x WALK_MAX_CONCURRENT_PLANS plans at a time (4 by default). Measured effect above: it halves
# the memory peak and keeps search fast under bursts at the same total throughput. 1..64.
# WALK_MAX_CONCURRENT_PLANS=2
# Check the size + sha256 of every bundle file at start-up (true; a mismatch refuses to start). false only for
# fast local restarts -- the image's entrypoint validates the bundle before uvicorn starts anyway.
# WALK_VERIFY_BUNDLE=true
# Plan one default walk per city at start-up (straight-line routing, no network): a bundle the planner cannot
# plan with fails the start-up instead of the first request. ~0.5 s.
# WALK_STARTUP_SMOKE_PLAN=true
# Request bodies above this size get 413 payload_too_large (1 MiB; a plan request is ~1-15 KB with 500
# favourites, an edit with the maximum 150 stops ~25 KB). 1024..67108864.
# WALK_MAX_BODY_BYTES=1048576

# ---------------------------------------------------------------------------------------------------------
# Routing chain: self-hosted OSRM -> ORS cloud -> straight-line estimate (walk_planner.routing.RoutingConfig)
# Plans never depend on it (the optimizer always uses the estimate); it only affects shown times and geometry.
# Every segment/plan reports its quality ("streets" | "estimate" | "mixed"). Nothing configured = estimate only.
# ---------------------------------------------------------------------------------------------------------
# OSRM base URL. Unset = the compose osrm-foot service (http://osrm-foot:5000); set it EMPTY to skip OSRM.
# WALK_ROUTER_URL=http://osrm-foot:5000
# OSRM profile name in the URL path.
# WALK_ROUTER_PROFILE=foot
# Seconds between OSRM data_version/health probes (background, at most one per interval; 0 = off).
# WALK_ROUTER_PROBE_S=60
# Routing time budget of ONE planning request, shared by all its variants (seconds).
# WALK_ROUTING_DEADLINE_S=6

# SECRET. OpenRouteService key: fallback when OSRM is down. Use a production key of its own (not the
# research dashboard's key). Empty = no ORS fallback.
ORS_API_KEY=
# ORS host (api.openrouteservice.org is being shut down; keys work on the heigit host).
# ORS_BASE_URL=https://api.heigit.org/openrouteservice
# Local ORS rate limits, PER WORKER PROCESS (defaults 35/min and 1800/day suit one process). The free plan
# allows 40/min and 2000/day per key, so with WEB_CONCURRENCY=2 keep the totals under it:
ORS_MAX_PER_MIN=17
ORS_MAX_PER_DAY=900

# Optional L2 leg cache shared by all workers (needs the `cache` compose profile, or the backend's Redis).
# Unset = in-process LRU only. May hold a password, which is why it lives only in this file.
# WALK_ROUTE_CACHE_REDIS_URL=redis://redis:6379/5

# ---------------------------------------------------------------------------------------------------------
# uvicorn (image defaults; any CLI option can be given as UVICORN_<OPTION>)
# ---------------------------------------------------------------------------------------------------------
# Off: the service writes one JSON line per request itself. uvicorn's own lines (supervisor, worker start /
# stop) are JSON too: the image's CMD passes --log-config /etc/walk-planner/uvicorn-log-config.json.
# UVICORN_ACCESS_LOG=false
# Seconds to finish in-flight requests on `docker stop` (compose stop_grace_period is 30 s).
# UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=20
# Keep idle connections longer than the gateway's keep-alive (avoids ECONNRESET on reused sockets).
# UVICORN_TIMEOUT_KEEP_ALIVE=65
# Recycle a worker after N requests if RSS creeps (only with WEB_CONCURRENCY >= 2; the jitter staggers them).
# UVICORN_LIMIT_MAX_REQUESTS=20000
# UVICORN_LIMIT_MAX_REQUESTS_JITTER=2000

# Path of THIS file for compose's env_file: (default /opt/sloco-data/walk/walk.env). Set it here when
# walk.env lives elsewhere, otherwise `docker compose` stops with "env file ... not found".
# WALK_ENV_FILE=/opt/sloco-data/walk/walk.env
