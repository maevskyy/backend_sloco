APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
SERVICE_NAME=recommendation-service
EMBEDDINGS_NPY_PATH=artifacts/location_embeddings_20260531T173837Z.npy
EMBEDDING_METADATA_PATH=artifacts/location_embeddings_20260531T173837Z_metadata.csv
EMBEDDING_RUN_ID=20260531T173837Z
RECOMMEND_DEFAULT_LIMIT=50
RECOMMEND_MAX_LIMIT=200
FAVORITES_WEIGHT=1.0
WANT_TO_GO_WEIGHT=0.55

# Recommendation algorithm: embedding_recommender_v1 (legacy) | location_recommender_v4
RECOMMENDER_ALGORITHM=embedding_recommender_v1
# Used only by location_recommender_v4:
LOCATIONS_CSV_PATH=artifacts/locations_combined_food_ttd.csv
RECOMMENDER_WEIGHTS_PRESET=text_only
# Direct-image (photo) channel — leave empty to keep it off. Set BOTH together with
# RECOMMENDER_WEIGHTS_PRESET=text_direct, or the photo weight scores nothing.
DIRECT_IMAGE_EMBEDDINGS_NPY_PATH=
DIRECT_IMAGE_METADATA_PATH=
